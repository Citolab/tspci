{
  "name": "my-pci",
  "description": "Here your PCI description",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/types.d.ts",
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@citolab/tspci": "latest",
    "tslib": "^2.8.1"
  },
  "scripts": {
    "dev": "tspci --dev",
    "prod": "tspci",
    "tspci": "tspci"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "myPci",
      "label": "My PCI",
      "response": {
        "cardinality": "single",
        "baseType": "integer"
      },
      "score": [
        "MATCH_CORRECT",
        "NONE"
      ],
      "correctResponse": "settings"
    }
  },
  "source": "src/index.ts"
}
